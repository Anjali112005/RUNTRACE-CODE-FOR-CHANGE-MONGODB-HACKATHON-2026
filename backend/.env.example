# RunTrace backend configuration. Copy to .env and edit. Never commit .env.

# MongoDB connection. Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
RUNTRACE_MONGODB_URI=mongodb://127.0.0.1:27017
RUNTRACE_MONGODB_DB=runtrace
RUNTRACE_MONGODB_TIMEOUT_MS=3000

# Server
RUNTRACE_HOST=127.0.0.1
RUNTRACE_PORT=8000
RUNTRACE_LOG_LEVEL=INFO

# Comma-separated list of browser origins allowed to call the API (the Vite dev server).
RUNTRACE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional dashboard/admin token. When empty, management endpoints are open
# (fine for a local-only tool bound to 127.0.0.1). When set, the dashboard must
# send it in the X-RunTrace-Admin-Token header (enter it on the Settings page).
RUNTRACE_ADMIN_TOKEN=

# Limits
RUNTRACE_MAX_REQUEST_BYTES=1048576
RUNTRACE_MAX_EVENTS_PER_BATCH=500
RUNTRACE_MAX_FIELD_CHARS=8000
RUNTRACE_INGEST_RATE_PER_MINUTE=1200
RUNTRACE_API_RATE_PER_MINUTE=600
RUNTRACE_STALE_RUN_MINUTES=60

# Extra metadata keys to redact (comma-separated, case-insensitive), in addition to built-ins.
RUNTRACE_REDACT_KEYS=

# Optional Gemini integration (server-side only). Leave empty to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
